    "custom_css": "/* Needs Elementor Pro (Custom CSS). Pill arrow circle + icon size; classic Button has no icon background control. */\nselector .gw-pill .elementor-button { display: inline-flex; align-items: center; min-height: 52px; transition: opacity .3s; }\nselector .gw-pill .elementor-button:hover { opacity: .85; }\nselector .gw-pill .elementor-button-content-wrapper { align-items: center; }\nselector .gw-pill .elementor-button-icon svg { width: 16px; height: auto; }\nselector .gw-pill--primary .elementor-button-icon { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; background: #FFFFFF; }\nselector .gw-hero-photo img { max-width: none; }\n/* v2 responsive art: photo/overlay fill the hero height; text column stays on top. */\nselector .gw-hero-art, selector .gw-hero-overlay { top: 0; bottom: 0; }\nselector .gw-hero-photo { top: 0; bottom: 0; }\nselector .gw-hero-photo > .elementor-widget-container, selector .gw-hero-photo img { height: 100% !important; }\nselector .gw-hero-content { position: relative; z-index: 4; }\n/* 1025-1366px safety (mirrors the _laptop values; works even if the Laptop breakpoint is disabled) */\n@media (min-width: 1025px) and (max-width: 1366px) {\n  selector .gw-hero-content { padding: 160px 48px 64px !important; }\n  selector .gw-hero-intro, selector .gw-hero-highlights { width: min(100%, 52vw) !important; }\n  selector .gw-hero-h1 .elementor-heading-title { font-size: 52px !important; line-height: 54px !important; }\n}\n/* Glacier West overflow safety, 980-1440px (Elementor Pro Custom CSS). Mirrors the _laptop values, so it also works\n   when the Laptop breakpoint is NOT enabled in Site Settings > Layout > Breakpoints. Scoped to .gw-sec sections only. */\n.gw-sec .e-con, .gw-sec .elementor-widget { min-width: 0; }\n.gw-sec .elementor-heading-title, .gw-sec .elementor-widget-text-editor { overflow-wrap: break-word; }\n@media (min-width: 1025px) and (max-width: 1366px) {\n  .gw-sec > .gw-inner { padding-left: 48px !important; padding-right: 48px !important; }\n  .gw-sec .gw-gap-lg { column-gap: 40px !important; }\n  .gw-sec .gw-wwb-panel { margin-right: -48px !important; padding: 96px 48px 56px 32px !important; }\n  .gw-sec .gw-pad-lg { padding-left: 48px !important; padding-right: 48px !important; }\n  .gw-sec .gw-fs-xl .elementor-heading-title, .gw-sec .gw-fs-xl.elementor-widget-text-editor, .gw-sec .gw-fs-xl .elementor-widget-container { font-size: 52px !important; line-height: 1.05 !important; }\n  .gw-sec .gw-fs-lg .elementor-heading-title, .gw-sec .gw-fs-lg.elementor-widget-text-editor, .gw-sec .gw-fs-lg .elementor-widget-container { font-size: 44px !important; line-height: 1.2 !important; }\n  .gw-sec .gw-fs-md .elementor-heading-title, .gw-sec .gw-fs-md.elementor-widget-text-editor, .gw-sec .gw-fs-md .elementor-widget-container { font-size: 40px !important; }\n}\n",
